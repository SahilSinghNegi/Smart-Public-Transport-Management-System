    int stopCount;
    int roadKm[Max_Stops][Max_Stops];
    int roadMinutes[Max_Stops][Max_Stops];

public:
    RoadMap() : stopCount(0) {
        for (int a = 0; a < Max_Stops; a++) {
            for (int b = 0; b < Max_Stops; b++) {
                roadKm[a][b] = 0;
                roadMinutes[a][b] = 0;
            }
        }
    }
